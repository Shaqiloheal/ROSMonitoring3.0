low_battery matches {topic:'battery_percentage', data:val} with val >= 0.0 && val < 20.0;
normal_battery matches {topic:'battery_percentage', data:val} with val >= 20.0 && val <= 100.0;
invalid_battery matches {topic:'battery_percentage', data:val} with val < 0.0 || val > 100.0;

Main = (normal_battery)*;
